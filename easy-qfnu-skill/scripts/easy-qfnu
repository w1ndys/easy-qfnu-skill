#!/usr/bin/env sh
set -eu

script_dir=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd -P)
skill_dir=$(CDPATH= cd -- "$script_dir/.." && pwd -P)

# An explicit override remains available for development and diagnostics.
if [ -n "${QFNU_CLI_BIN:-}" ]; then
  if [ ! -x "$QFNU_CLI_BIN" ]; then
    echo "QFNU_CLI_BIN is not executable: $QFNU_CLI_BIN" >&2
    exit 1
  fi
  exec "$QFNU_CLI_BIN" "$@"
fi

for candidate in "$skill_dir/bin/easy-qfnu" "$skill_dir/bin/easy-qfnu.exe"; do
  if [ -x "$candidate" ]; then
    exec "$candidate" "$@"
  fi
done

cat >&2 <<EOF
未找到 skill 目录下的 easy-qfnu CLI。
请先在 skill 目录执行：
  ./scripts/install-easy-qfnu
安装位置：$skill_dir/bin
EOF
exit 127
