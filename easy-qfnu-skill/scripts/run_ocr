#!/usr/bin/env python3
"""Start the local ddddocr Flask service using the OCR venv."""

from __future__ import annotations

import os
import sys
from pathlib import Path

SKILL_ROOT = Path(__file__).resolve().parents[1]
OCR_DIR = SKILL_ROOT / "ocr"
VENV_PY = OCR_DIR / (".venv/Scripts/python.exe" if os.name == "nt" else ".venv/bin/python")
SERVER = OCR_DIR / "server.py"


def main() -> int:
    if not VENV_PY.exists():
        sys.stderr.write(
            f"OCR venv not found at {VENV_PY}\n"
            "Install it first: python3 scripts/setup_ocr\n"
        )
        return 1
    os.execv(str(VENV_PY), [str(VENV_PY), str(SERVER), *sys.argv[1:]])
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
