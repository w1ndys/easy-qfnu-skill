#!/usr/bin/env python3
"""Create a local venv and install ddddocr + Flask for captcha OCR.

Prefers uv when it is on PATH (faster on local agents / cloud VMs).
Otherwise falls back to the stdlib venv + pip. uv is never required.
"""

from __future__ import annotations

import argparse
import os
import shutil
import subprocess
import sys
from pathlib import Path

SKILL_ROOT = Path(__file__).resolve().parents[1]
OCR_DIR = SKILL_ROOT / "ocr"
VENV_DIR = OCR_DIR / ".venv"
REQ = OCR_DIR / "requirements.txt"
VALID_INSTALLERS = ("auto", "uv", "pip")


def venv_python() -> Path:
    if os.name == "nt":
        return VENV_DIR / "Scripts" / "python.exe"
    return VENV_DIR / "bin" / "python"


def run(cmd: list[str]) -> None:
    print("+", " ".join(cmd), flush=True)
    subprocess.check_call(cmd)


def find_uv() -> str | None:
    return shutil.which("uv")


def resolve_installer(requested: str) -> tuple[str, str | None]:
    uv_path = find_uv()
    if requested == "uv":
        if not uv_path:
            sys.stderr.write(
                "`uv` was requested but not found on PATH.\n"
                "Install uv, or rerun with --installer pip.\n"
            )
            raise SystemExit(1)
        return "uv", uv_path
    if requested == "pip":
        return "pip", uv_path
    if uv_path:
        return "uv", uv_path
    return "pip", None


def venv_has_pip(py: Path) -> bool:
    if not py.exists():
        return False
    proc = subprocess.run(
        [str(py), "-m", "pip", "--version"],
        stdout=subprocess.DEVNULL,
        stderr=subprocess.DEVNULL,
    )
    return proc.returncode == 0


def create_venv_uv(uv_path: str) -> None:
    cmd = [
        uv_path,
        "venv",
        "--python",
        sys.executable,
        "--no-project",
        "--no-python-downloads",
    ]
    if VENV_DIR.exists():
        cmd.append("--allow-existing")
    cmd.append(str(VENV_DIR))
    run(cmd)


def create_venv_pip() -> None:
    OCR_DIR.mkdir(parents=True, exist_ok=True)
    run([sys.executable, "-m", "venv", str(VENV_DIR)])


def create_venv(installer: str, uv_path: str | None, *, force: bool = False) -> None:
    if not force and venv_python().exists():
        return
    if installer == "uv":
        assert uv_path is not None
        create_venv_uv(uv_path)
        return
    create_venv_pip()


def install_requirements(installer: str, uv_path: str | None) -> None:
    py = venv_python()
    if not py.exists():
        raise SystemExit(f"venv python missing: {py}")
    if installer == "uv":
        assert uv_path is not None
        run([uv_path, "pip", "install", "--python", str(py), "-r", str(REQ)])
        return
    if not venv_has_pip(py):
        run([str(py), "-m", "ensurepip", "--upgrade"])
    run([str(py), "-m", "pip", "install", "--upgrade", "pip"])
    run([str(py), "-m", "pip", "install", "-r", str(REQ)])


def parse_args() -> argparse.Namespace:
    env_default = os.environ.get("QFNU_OCR_INSTALLER", "auto").strip().lower() or "auto"
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument(
        "--installer",
        choices=VALID_INSTALLERS,
        default=env_default,
        help="auto (default): uv if on PATH, else pip. Also QFNU_OCR_INSTALLER.",
    )
    return parser.parse_args()


def print_ready(used: str) -> None:
    py = venv_python()
    print()
    print(f"OCR venv ready ({used}).")
    print("Start the service:")
    print(f"  {py} {OCR_DIR / 'server.py'} --host 127.0.0.1 --port 5000")
    print()
    print("Then login with:")
    print("  python3 scripts/qfnu jwxt login --username <学号> --password <密码>")
    print("Default OCR URL: http://127.0.0.1:5000  (override with --ocr-url or QFNU_OCR_URL)")


def main() -> int:
    args = parse_args()
    requested = args.installer
    if requested not in VALID_INSTALLERS:
        sys.stderr.write(f"unknown installer {requested!r}; use auto, uv, or pip\n")
        return 2
    if not REQ.exists():
        sys.stderr.write(f"missing {REQ}\n")
        return 1

    installer, uv_path = resolve_installer(requested)
    if installer == "uv":
        print(f"OCR installer: uv ({uv_path})", flush=True)
    else:
        print("OCR installer: pip (stdlib venv)", flush=True)

    used = installer
    try:
        create_venv(installer, uv_path)
        install_requirements(installer, uv_path)
    except subprocess.CalledProcessError:
        if requested != "auto" or installer != "uv":
            raise
        sys.stderr.write("uv failed; falling back to stdlib venv + pip\n")
        used = "pip"
        if not venv_has_pip(venv_python()):
            create_venv("pip", None, force=True)
        install_requirements("pip", None)

    print_ready(used)
    return 0


if __name__ == "__main__":
    try:
        raise SystemExit(main())
    except subprocess.CalledProcessError as exc:
        raise SystemExit(exc.returncode) from exc
